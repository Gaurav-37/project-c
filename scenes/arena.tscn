[node name="Arena" type="Node3D"]

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("Environment_arena")

[node name="Sun" type="DirectionalLight3D" parent="."]
transform = Transform3D(0.78086, -0.52608, 0.33686, 0, 0.53923, 0.84215, -0.62469, -0.6576, 0.42108, 0, 8, 0)
shadow_enabled = true

; Orthogonal, size 14, position (0, 14, 10), rotation (-50, 0, 0) degrees on X.
[node name="Camera3D" type="Camera3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 0.6427876, 0.7660444, 0, -0.7660444, 0.6427876, 0, 14, 10)
projection = 1
size = 14.0

; 20 x 1 x 20, top face sitting exactly at y = 0 so the player stands on zero.
[node name="Floor" type="CSGBox3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -0.5, 0)
use_collision = true
size = Vector3(20, 1, 20)

[node name="Player" type="CharacterBody3D" parent="."]
script = ExtResource("1_player")
starting_attack = ExtResource("3_glaive_l1")
attack_library = [ExtResource("3_glaive_l1"), ExtResource("4_glaive_l2")]
hitbox_path = NodePath("Hitbox")
mesh_path = NodePath("Mesh")

[node name="Mesh" type="MeshInstance3D" parent="Player"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1, 0)
mesh = SubResource("CapsuleMesh_player")

[node name="CollisionShape3D" type="CollisionShape3D" parent="Player"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1, 0)
shape = SubResource("CapsuleShape3D_player")

; Layer 0 / mask 2: the hitbox detects only things on the "enemy" layer.
; Without this it would report the floor's collision body as a hit every swing.
; Position is overwritten each active frame from AttackData.hitbox_offset.
[node name="Hitbox" type="Area3D" parent="Player"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1, -1.5)
collision_layer = 0
collision_mask = 2
monitoring = false

[node name="CollisionShape3D" type="CollisionShape3D" parent="Player/Hitbox"]
shape = SubResource("BoxShape3D_hitbox")
disabled = true

; Build order step 4's other half: something to hit.
;
; Placed on -Z because the player does not turn yet — rotation and target
; snapping are step 8, so "forward" is always -Z and the hitbox only ever
; sweeps that way. Sits just inside L1's reach from the spawn point, so the
; first left-click of a session connects without moving first.
;
; Layer 3 = bits 1 and 2. Bit 2 is what the player's hitbox scans for; bit 1
; is what the player's BODY collides with, so the dummy is solid rather than
; something you walk through.
[node name="Dummy" type="StaticBody3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, -2.2)
collision_layer = 3
collision_mask = 0
script = ExtResource("5_dummy")
mesh_path = NodePath("Mesh")
label_path = NodePath("Label")

[node name="Mesh" type="MeshInstance3D" parent="Dummy"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1, 0)
mesh = SubResource("BoxMesh_dummy")

[node name="CollisionShape3D" type="CollisionShape3D" parent="Dummy"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1, 0)
shape = SubResource("BoxShape3D_dummy")

[node name="Label" type="Label3D" parent="Dummy"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 2.6, 0)
billboard = 1
no_depth_test = true
fixed_size = true
pixel_size = 0.002
text = "HP"

